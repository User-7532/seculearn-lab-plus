{
  "name": "KnowledgeCard",
  "properties": {
    "answer": {
      "description": "空所に入る語句（記述では要点）",
      "type": "string"
    },
    "difficulty": {
      "default": "basic",
      "enum": [
        "basic",
        "intermediate",
        "advanced"
      ],
      "type": "string"
    },
    "explanation": {
      "description": "解説",
      "type": "string"
    },
    "kind": {
      "default": "cloze",
      "description": "cloze=穴埋め written=記述",
      "enum": [
        "cloze",
        "written"
      ],
      "type": "string"
    },
    "model_answer": {
      "description": "記述の模範解答",
      "type": "string"
    },
    "text": {
      "description": "穴埋めの文章（空所は ___）または記述の問い",
      "type": "string"
    },
    "topic": {
      "description": "分野。ラボのslug（sql-injection など）か basics",
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "ai",
        "import"
      ],
      "description": "ai=分野を選んでAIが作成 / import=ほかのAIとの会話を取り込んで作成"
    }
  },
  "required": [
    "topic",
    "text",
    "answer"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    }
  },
  "type": "object"
}