{
  "name": "LabProgress",
  "properties": {
    "attempts": {
      "default": 0,
      "description": "\u30d5\u30e9\u30b0\u63d0\u51fa\u56de\u6570",
      "type": "number"
    },
    "cleared_at": {
      "description": "\u30af\u30ea\u30a2\u65e5\u6642",
      "format": "date-time",
      "type": "string"
    },
    "hints_used": {
      "default": 0,
      "description": "\u958b\u3044\u305f\u30d2\u30f3\u30c8\u6570",
      "type": "number"
    },
    "lab_slug": {
      "description": "\u6f14\u7fd2\u30e9\u30dc\u306e\u8b58\u5225\u5b50",
      "type": "string"
    },
    "status": {
      "default": "in_progress",
      "description": "\u9032\u884c\u72b6\u6cc1",
      "enum": [
        "in_progress",
        "cleared"
      ],
      "type": "string"
    },
    "xp": {
      "default": 0,
      "description": "\u7372\u5f97XP",
      "type": "number"
    }
  },
  "required": [
    "lab_slug"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    }
  },
  "type": "object"
}